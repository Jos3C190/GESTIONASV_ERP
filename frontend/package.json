{
  "name": "erp-frontend",
  "version": "0.1.0",
  "description": "ERP System — frontend (SvelteKit 5, TypeScript strict, Tailwind).",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rimraf .svelte-kit build node_modules/.vite"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "rimraf": "^6.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.7.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^5.59.0",
    "jsbarcode": "^3.12.3",
    "qrcode": "1.5.4",
    "zod": "^3.23.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.20",
      "brace-expansion@2": "2.1.6",
      "brace-expansion@5": "5.0.11",
      "browserslist": "4.28.7",
      "devalue": "5.9.3",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.18",
      "source-map-js": "1.2.2",
      "tinypool": "2.1.2"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  }
}
