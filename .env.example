# =============================================================
# ERP System — Environment variables (PHASE 0 / cimientos)
# =============================================================
# Copy to .env and adjust. Never commit the real .env file.
# All secrets MUST come from environment in production.

# ---------- Postgres ----------
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=change_me_in_production_please
POSTGRES_DB=erp_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_TEST_DB=erp_db_test

# Backend reads these to build its DSN:
DATABASE_URL=postgresql+asyncpg://erp_admin:change_me_in_production_please@db:5432/erp_db
# Sync URL used by Alembic only (psycopg3 driver):
DATABASE_URL_SYNC=postgresql+psycopg://erp_admin:change_me_in_production_please@db:5432/erp_db

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_STARTUP=false
APP_NAME=ERP System

# ---------- Initial development bootstrap ----------
# The one-shot Compose service runs this idempotent seed before the frontend.
# Disable it outside local/review environments and provision production data separately.
AUTO_SEED=true
# Ordinary restarts skip an initialized dataset. Set true only for an explicit
# reconciliation of the canonical development records.
FORCE_SEED=false
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@erp-system.dev
SUPER_ADMIN_PASSWORD=Cambio!Seguro2026

# CORS — comma separated, NEVER use "*" with credentials in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://proyecto-erp-one.vercel.app

# JWT — generate strong secrets, e.g. `openssl rand -hex 64`
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-GCM key for supplier bank account data (base64url, 32 decoded bytes).
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SUPPLIER_DATA_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_32_BYTE_BASE64URL_KEY

# Argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Rate limiting (requests per minute per IP on sensitive endpoints)
LOGIN_RATE_LIMIT=10/minute
REFRESH_RATE_LIMIT=30/minute
RESET_RATE_LIMIT=5/minute

# Security headers
# Local HTTP development uses false; production must use true behind HTTPS.
SECURE_COOKIES=false

# ---------- Frontend (SvelteKit) ----------
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_NAME=ERP System
VITE_API_URL=http://localhost:8000
PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------- Cloudinary ----------
# La API secret se usa solamente en el backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=erp-system
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_SIGNATURE_TTL_SECONDS=300

# ---------- Local document storage (RustFS + ClamAV) ----------
# `make setup` generates unique values when these markers are still present.
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_GENERATE_LOCAL_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_GENERATE_LOCAL_SECRET_KEY
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=erp-documents
OBJECT_STORAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=600
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=300
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PENDING_PER_USER=20
DOCUMENT_PENDING_RETENTION_HOURS=24
DOCUMENT_QUARANTINE_RETENTION_DAYS=7
DOCUMENT_DELETION_RETENTION_DAYS=30
DOCUMENT_SCAN_STALE_MINUTES=15
DOCUMENT_MAINTENANCE_INTERVAL_SECONDS=3600
CLAMAV_TIMEOUT_SECONDS=120

# ---------- Redis + asynchronous OCR ----------
# `make setup` replaces this marker in the ignored local `.env`.
REDIS_PASSWORD=CHANGE_ME_GENERATE_LOCAL_REDIS_PASSWORD
REDIS_ENABLED=false
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=0.2

OCR_ENABLED=false
OCR_LANGUAGES=spa+eng
OCR_JOB_TIMEOUT_SECONDS=900
OCR_TESSERACT_TIMEOUT_SECONDS=120
OCR_MAX_PAGES=300
OCR_MAX_OUTPUT_BYTES=104857600
OCR_SKIP_BIG_MPIX=50
OCR_MAX_ATTEMPTS=3
OCR_STALE_MINUTES=20
OCR_RECONCILE_SECONDS=15
