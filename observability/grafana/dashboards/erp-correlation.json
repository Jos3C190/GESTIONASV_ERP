    {"id": 3, "type": "logs", "title": "Logs correlacionados", "datasource": {"uid": "loki"}, "targets": [{"expr": "{service_name=~\"erp-.+\"}", "refId": "A"}], "gridPos": {"x": 0, "y": 16, "w": 24, "h": 10}}
