{
  "uid": "erp-ocr-redis", "title": "ERP — OCR y Redis", "tags": ["erp", "ocr", "redis"],
  "schemaVersion": 41, "editable": false, "refresh": "15s", "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Trabajos OCR por estado", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (status) (increase(erp_erp_ocr_jobs_total[15m]))", "legendFormat": "{{status}}", "refId": "A"}], "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}},
    {"id": 2, "type": "timeseries", "title": "Duración OCR p95", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(erp_erp_ocr_duration_bucket[15m])))", "refId": "A"}], "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}},
    {"id": 3, "type": "stat", "title": "OCR pendientes", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "erp_erp_ocr_pending{service_name=\"erp-ocr-worker\"}", "refId": "A"}], "gridPos": {"x": 0, "y": 8, "w": 6, "h": 5}},
    {"id": 4, "type": "stat", "title": "Mayor antigüedad pendiente (s)", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "erp_erp_ocr_pending_age{service_name=\"erp-ocr-worker\"}", "refId": "A"}], "gridPos": {"x": 6, "y": 8, "w": 6, "h": 5}},
    {"id": 5, "type": "timeseries", "title": "Rate limiting Redis vs fallback", "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (store, result) (rate(erp_erp_rate_limit_decisions_total[5m]))", "legendFormat": "{{store}} {{result}}", "refId": "A"}], "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}},
    {"id": 6, "type": "logs", "title": "Logs del worker", "datasource": {"uid": "loki"}, "targets": [{"expr": "{service_name=\"erp-ocr-worker\"}", "refId": "A"}], "gridPos": {"x": 0, "y": 16, "w": 24, "h": 9}}
  ]
}
