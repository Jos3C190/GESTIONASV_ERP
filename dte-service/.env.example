# ---- Identidad fiscal del emisor (contribuyente) ----
DTE_MODE=hacienda-test
DTE_SIMULATION_ACKNOWLEDGED=false
DTE_SIMULATION_RUN_ID=
DTE_SIMULATION_SCENARIO=success
DTE_SIMULATION_SQLITE_PATH=./data/dte-simulation.db
DTE_SIMULATION_WATERMARK=DOCUMENTO SIMULADO - SIN VALIDEZ FISCAL
# Estos campos son EXACTAMENTE los que exige identificacion/emisor del JSON
# Schema oficial (fe-f-v2.json, fe-ccf-v4.json, etc.)
MH_NIT=06141804941035
MH_NRC=1234567
MH_NOMBRE=Mi Empresa S.A. de C.V.
MH_NOMBRE_COMERCIAL=Mi Empresa
MH_COD_ACTIVIDAD=62010
MH_DESC_ACTIVIDAD=Programación informática
MH_TELEFONO=22221111
MH_CORREO=facturacion@miempresa.com

# Dirección del emisor (códigos CAT-012 Departamento, CAT-013 Municipio,
# CAT-008 Distrito — ver src/config/catalogos.json para valores válidos)
MH_DIR_DEPARTAMENTO=06
MH_DIR_MUNICIPIO=23
MH_DIR_DISTRITO=14
MH_DIR_COMPLEMENTO=Calle Principal #123, San Salvador

# ---- Credenciales de autenticación / firma ----
MH_PASSWORD_API=CAMBIA_ESTA_CLAVE_API
MH_PASSWORD_PRI=CAMBIA_ESTA_CLAVE_DE_LLAVE_PRIVADA

# ---- Ambiente: "00" = pruebas, "01" = produccion ----
MH_AMBIENTE=00

# ---- Códigos internos del contribuyente (informativos, van en emisor.codEstable
#      y emisor.codPuntoVenta del cuerpo del DTE; pueden dejarse vacíos) ----
MH_COD_ESTABLE_INTERNO=CASA
MH_COD_PUNTO_VENTA_INTERNO=

# ---- Códigos OFICIALES de Hacienda (Formulario F-210) para el Número de Control ----
# MH_TIPO_ESTABLECIMIENTO usa CAT-009: 01 Sucursal, 02 Casa Matriz, 04 Bodega, 07 Patio
MH_TIPO_ESTABLECIMIENTO=02
MH_COD_ESTABLECIMIENTO=001
MH_COD_PUNTO_VENTA=001

# ---- URLs Hacienda (test por defecto; cambiar a prod en .env real) ----
# Confirmadas contra el Manual Tecnologico para la Integracion del Sistema de
# Transmision V2.0 (Ministerio de Hacienda, 05/2026).
MH_AUTH_URL=https://apitest.dtes.mh.gob.sv/seguridad/auth
MH_RECEPCION_URL=https://apitest.dtes.mh.gob.sv/fesv/recepciondte
MH_RECEPCION_LOTE_URL=https://apitest.dtes.mh.gob.sv/fesv/recepcionlote
MH_ANULACION_URL=https://apitest.dtes.mh.gob.sv/fesv/anulardte
MH_CONTINGENCIA_URL=https://apitest.dtes.mh.gob.sv/fesv/contingencia
MH_CONSULTA_URL=https://apitest.dtes.mh.gob.sv/fesv/recepcion/consultadte
MH_CONSULTA_LOTE_URL=https://apitest.dtes.mh.gob.sv/fesv/recepcion/consultadtelote

# ---- Firmador (servicio local, el jar/contenedor de Hacienda) ----
FIRMADOR_URL=http://localhost:8113/firmardocumento/

# ---- Seguridad del propio microservicio (NO confundir con MH_PASSWORD_API) ----
# Una o más API keys separadas por coma, para autenticar a los consumidores
# de este microservicio (tu ERP/POS). Genera una con:
#   node scripts/generar-api-key.js
# Sin esto, el servidor se niega a arrancar (falla rápido a propósito).
MS_API_KEYS=
# Scopes por key, en el mismo orden y separados por punto y coma. Ejemplo:
# MS_API_KEYS=key-checkout,key-fiscal
# MS_API_KEY_SCOPES=issue,read;issue,read,invalidate,contingency
# Si se omite, cada key recibe solo issue,read.
MS_API_KEY_SCOPES=

# Tipos de DTE habilitados para emisión por este servicio. El valor seguro
# inicial coincide con el checkout: Factura 01 y CCF 03.
DTE_ALLOWED_DOCUMENT_TYPES=01,03
DTE_AUTHORIZED_ISSUER_NITS=06141804941035

# Solo para desarrollo local: si de verdad no quieres configurar una key
# todavía, descomenta esta línea explícitamente (NUNCA en producción).
# MS_AUTH_DESHABILITADA=true

# Rate limiting por API key (0 = deshabilitado)
MS_RATE_LIMIT_MAX=120
MS_RATE_LIMIT_WINDOW_MS=60000

# ---- Servidor ----
PORT=3000
LOG_LEVEL=info

# ---- Base de datos local (correlativos + cola de contingencia) ----
SQLITE_PATH=./data/dte.db

# ---- Reintentos ----
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=2000
